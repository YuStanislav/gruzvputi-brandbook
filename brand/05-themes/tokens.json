{
  "brand": "Груз в пути",
  "version": "1.0",
  "colorSpace": "sRGB",
  "palette": {
    "navy": "#061F4B",
    "blue": "#0066FF",
    "white": "#FFFFFF",
    "ice": "#F4F7FC",
    "midnight": "#071426",
    "sky": "#6BABFF"
  },
  "themes": {
    "light": {
      "background": "#F4F7FC",
      "surface": "#FFFFFF",
      "surfaceRaised": "#EAF0F9",
      "text": "#061F4B",
      "textMuted": "#52637B",
      "border": "#7386A1",
      "primary": "#0066FF",
      "primaryHover": "#0057DB",
      "onPrimary": "#FFFFFF",
      "link": "#0057DB",
      "focus": "#0057DB",
      "success": "#147346",
      "warning": "#8A4B00",
      "error": "#B42318"
    },
    "dark": {
      "background": "#071426",
      "surface": "#10243D",
      "surfaceRaised": "#17314F",
      "text": "#F4F7FC",
      "textMuted": "#AFBED1",
